{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Grouped pull requests for npm, Gradle, GitHub Actions, and product Dockerfiles. Majors are ignored for npm and Gradle. The Renovate workflow decides when a run happens. Submodules stay uninitialized because axelix-enterprise has no URL in .gitmodules.",
  "cloneSubmodules": false,
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "constraints": {
    "npm": ">=11.18.0 <12"
  },
  "prCreation": "not-pending",
  "internalChecksFilter": "strict",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "enabledManagers": ["npm", "gradle", "github-actions", "dockerfile", "docker-compose"],
  "ignorePaths": [
    "playgrounds/**",
    "axelix-enterprise/**"
  ],
  "packageRules": [
    {
      "description": "npm and Gradle ignore major updates",
      "matchManagers": ["npm", "gradle"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Bump npm ranges the way Dependabot did",
      "matchManagers": ["npm"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Hold @rolldown/plugin-babel below 0.3 until @vitejs/plugin-react 6.2.0 is past minimumReleaseAge (published 2026-11-02, eligible 2026-11-05). plugin-react 6.1.2 only accepts plugin-babel ^0.1.7 || ^0.2.0, so 0.3.0 cannot be locked yet. Remove this rule after 2026-11-05.",
      "matchManagers": ["npm"],
      "matchFileNames": ["master/front-end/**"],
      "matchPackageNames": ["@rolldown/plugin-babel"],
      "allowedVersions": "<0.3.0"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["website/**"],
      "groupName": "npm dependencies in /website",
      "separateMajorMinor": false
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["master/front-end/**"],
      "groupName": "npm dependencies in /master/front-end",
      "separateMajorMinor": false
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["docs/**"],
      "groupName": "npm dependencies in /docs",
      "separateMajorMinor": false
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["blog/**"],
      "groupName": "npm dependencies in /blog",
      "separateMajorMinor": false
    },
    {
      "matchManagers": ["gradle"],
      "groupName": "gradle dependencies",
      "separateMajorMinor": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions dependencies",
      "separateMajorMinor": false
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchFileNames": ["docker-compose.yml", "Dockerfile"],
      "groupName": "docker dependencies in /",
      "separateMajorMinor": false
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchFileNames": ["website/**"],
      "groupName": "docker dependencies in /website",
      "separateMajorMinor": false
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchFileNames": ["docs/**"],
      "groupName": "docker dependencies in /docs",
      "separateMajorMinor": false
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchFileNames": ["blog/**"],
      "groupName": "docker dependencies in /blog",
      "separateMajorMinor": false
    },
    {
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["master-oss/**"],
      "groupName": "docker dependencies in /master-oss",
      "separateMajorMinor": false
    }
  ]
}
