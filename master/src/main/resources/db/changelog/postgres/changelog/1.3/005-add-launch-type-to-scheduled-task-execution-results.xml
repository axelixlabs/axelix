<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="1.3-005-postgres-add-launch-type-to-scheduled-task-execution-results" author="Axelix Team">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not>
        <columnExists tableName="scheduled_task_execution_results" columnName="launch_type"/>
      </not>
    </preConditions>

    <comment>
      Adds the launch type of the execution and the name of the instance that ran it. The columns are mandatory,
      so the rows stored before are dropped.
    </comment>

    <delete tableName="scheduled_task_execution_results"/>

    <addColumn tableName="scheduled_task_execution_results">
      <column name="launch_type" type="TEXT">
        <constraints nullable="false"/>
      </column>
      <column name="instance_name" type="TEXT">
        <constraints nullable="false"/>
      </column>
    </addColumn>
  </changeSet>

  <changeSet id="1.3-005-2-postgres-add-task-index-to-scheduled-task-execution-results" author="Axelix Team">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not>
        <indexExists tableName="scheduled_task_execution_results" indexName="idx_scheduled_task_execution_results_task"/>
      </not>
    </preConditions>

    <createIndex tableName="scheduled_task_execution_results" indexName="idx_scheduled_task_execution_results_task">
      <column name="group_id"/>
      <column name="artifact_id"/>
      <column name="task_id"/>
      <column name="started_at"/>
    </createIndex>
  </changeSet>
</databaseChangeLog>
