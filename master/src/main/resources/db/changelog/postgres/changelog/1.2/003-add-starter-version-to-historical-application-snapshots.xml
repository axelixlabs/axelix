<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="1.2-003-1-postgres-clear-historical-application-snapshots" author="Axelix Team">
    <sql>DELETE FROM historical_application_snapshots</sql>
  </changeSet>

  <changeSet id="1.2-003-2-postgres-add-starter-version-to-historical-application-snapshots" author="Axelix Team">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not>
        <columnExists tableName="historical_application_snapshots" columnName="starter_version"/>
      </not>
    </preConditions>

    <addColumn tableName="historical_application_snapshots">
      <column name="starter_version" type="TEXT">
        <constraints nullable="false"/>
      </column>
    </addColumn>
  </changeSet>
</databaseChangeLog>
