<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="1.3-001-1-postgres-create-application-dependencies-table" author="Axelix Team">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not>
        <tableExists tableName="application_dependencies"/>
      </not>
    </preConditions>

    <createTable tableName="application_dependencies">
      <column name="group_id" type="TEXT">
        <constraints nullable="false"/>
      </column>
      <column name="artifact_id" type="TEXT">
        <constraints nullable="false"/>
      </column>
      <column name="sbom" type="TEXT">
        <constraints nullable="false"/>
      </column>
      <column name="reported_at" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addPrimaryKey
            tableName="application_dependencies"
            columnNames="group_id, artifact_id"
            constraintName="pk_application_dependencies"/>
  </changeSet>
</databaseChangeLog>
