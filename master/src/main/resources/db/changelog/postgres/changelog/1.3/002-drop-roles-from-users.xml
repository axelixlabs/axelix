<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="1.3-002-postgres-drop-roles-from-users" author="Axelix Team">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <columnExists tableName="users" columnName="roles"/>
    </preConditions>

    <comment>
      Drops the legacy users.roles JSON column. Its content was copied into users_roles by 1.1-010, and since 1.1
      nothing reads or writes it anymore.
    </comment>

    <dropColumn tableName="users" columnName="roles"/>
  </changeSet>
</databaseChangeLog>
