<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="1.2-002-1-mysql-add-spring-versions-to-historical-application-snapshots" author="Axelix Team">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not>
        <columnExists tableName="historical_application_snapshots" columnName="spring_boot_version"/>
      </not>
    </preConditions>

    <addColumn tableName="historical_application_snapshots">
      <column name="spring_boot_version" type="VARCHAR(255)">
        <constraints nullable="true"/>
      </column>
      <column name="spring_framework_version" type="VARCHAR(255)">
        <constraints nullable="true"/>
      </column>
    </addColumn>
  </changeSet>
</databaseChangeLog>
