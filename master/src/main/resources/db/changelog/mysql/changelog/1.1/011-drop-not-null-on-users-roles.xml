<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="1.1-011-1-mysql-drop-not-null-on-users-roles" author="Axelix Team">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <columnExists tableName="users" columnName="roles"/>
    </preConditions>

    <dropNotNullConstraint tableName="users" columnName="roles" columnDataType="VARCHAR(255)"/>
  </changeSet>
</databaseChangeLog>
