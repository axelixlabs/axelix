<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="1.3-008-mysql-add-codename-and-description-to-authorities" author="Axelix Team">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <and>
        <not>
          <columnExists tableName="authorities" columnName="codename"/>
        </not>
        <not>
          <columnExists tableName="authorities" columnName="description"/>
        </not>
      </and>
    </preConditions>

    <addColumn tableName="authorities">
      <column name="codename" type="VARCHAR(255)"/>
      <column name="description" type="TEXT"/>
    </addColumn>

    <update tableName="authorities">
      <column name="codename" value="environment.values:read"/>
      <column name="description" value="Grants the right to view values in Environment."/>
      <where>name = 'ENV_VALUES_READ'</where>
    </update>
    <update tableName="authorities">
      <column name="codename" value="config-properties.values:read"/>
      <column name="description" value="Grants the right to view values in Configuration Properties."/>
      <where>name = 'CONFIG_PROPS_VALUES_READ'</where>
    </update>
    <update tableName="authorities">
      <column name="codename" value="scheduled-tasks:write"/>
      <column name="description" value="Allows modifying individual tasks, forcing their execution, and enabling/disabling them at runtime."/>
      <where>name = 'SCHEDULED_TASKS_MODIFY'</where>
    </update>
    <update tableName="authorities">
      <column name="codename" value="caches:clear"/>
      <column name="description" value="Allows clearing individual caches, cache managers, and all application caches at runtime."/>
      <where>name = 'CACHES_CLEAR'</where>
    </update>
    <update tableName="authorities">
      <column name="codename" value="caches:toggle"/>
      <column name="description" value="Allows enabling/disabling individual caches and cache managers at runtime."/>
      <where>name = 'CACHES_TOGGLE'</where>
    </update>
    <update tableName="authorities">
      <column name="codename" value="gc:manage"/>
      <column name="description" value="Allows triggering garbage collection and enabling/disabling garbage collector log monitoring at runtime."/>
      <where>name = 'GARBAGE_COLLECTOR'</where>
    </update>
    <update tableName="authorities">
      <column name="codename" value="users:read"/>
      <column name="description" value="Grants the right to view managed users."/>
      <where>name = 'USERS_VIEW'</where>
    </update>
    <update tableName="authorities">
      <column name="codename" value="users:manage"/>
      <column name="description" value="Allows creating, updating, and deleting managed users at runtime."/>
      <where>name = 'USERS_MANAGEMENT'</where>
    </update>

    <addNotNullConstraint tableName="authorities" columnName="codename" columnDataType="VARCHAR(255)"/>
    <addNotNullConstraint tableName="authorities" columnName="description" columnDataType="TEXT"/>
  </changeSet>

  <changeSet id="1.3-008-2-mysql-unique-index-on-authorities-codename" author="Axelix Team">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not>
        <indexExists tableName="authorities" indexName="uq_authorities_codename"/>
      </not>
    </preConditions>

    <createIndex tableName="authorities" indexName="uq_authorities_codename" unique="true">
      <column name="codename"/>
    </createIndex>
  </changeSet>
</databaseChangeLog>
