<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!--
    The instances table holds soft state only: every managed service re-registers itself on the next
    heartbeat, so the rows are safe to drop instead of backfilling the new mandatory columns. This is
    also why we can replace the free-form java_version column with the structured JEP 322 coordinate
    (feature/interim/update/patch) outright.

    SQLite refuses ALTER TABLE ADD COLUMN with NOT NULL and no default even on an empty table, hence
    the DEFAULT '' / DEFAULT 0. So we cannot FORCE these columns to be not null on the database level.
    But we can be sure from the domain perspective, that they will always be populated, since the
    Axelix Master always populates them with some valid value.
  -->
  <changeSet id="1.2-001-1-sqlite-add-starter-and-structured-java-version-to-instances" author="Axelix Team">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not>
        <columnExists tableName="instances" columnName="starter_version"/>
      </not>
    </preConditions>

    <delete tableName="instances"/>

    <!-- Liquibase's <dropColumn> is a no-op on SQLite; use the native ALTER TABLE DROP COLUMN instead. -->
    <sql>
      ALTER TABLE instances DROP COLUMN java_version;
    </sql>

    <addColumn tableName="instances">
      <column name="starter_version" type="TEXT" defaultValue="">
        <constraints nullable="false"/>
      </column>
      <column name="java_feature" type="INT" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="java_interim" type="INT" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="java_update" type="INT" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="java_patch" type="INT" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
    </addColumn>
  </changeSet>
</databaseChangeLog>
