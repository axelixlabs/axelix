{
    "name": "@axelix/console",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "build": "tsc -b",
        "lint": "eslint .",
        "lint-css": "stylelint \"src/**/*.css\"",
        "lint:fix": "eslint . --fix",
        "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
        "test": "vitest",
        "cy:open": "cypress open",
        "check": "eslint . && stylelint \"src/**/*.css\" && vitest run && tsc -b"
    },
    "dependencies": {
        "@ant-design/icons": "^6.3.4",
        "@reduxjs/toolkit": "^2.13.0",
        "@tanstack/react-virtual": "^3.14.24",
        "antd": "^6.6.8",
        "axios": "^1.21.0",
        "cronstrue": "^3.38.0",
        "dayjs": "^1.11.23",
        "i18next": "^25.10.10",
        "i18next-browser-languagedetector": "^8.2.4",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^16.6.0",
        "react-redux": "^9.3.1",
        "react-router": "^7.18.2",
        "recharts": "^3.10.1",
        "timepicker-ui": "^4.6.0"
    },
    "files": [
        "src",
        "cypress",
        "cypress.config.ts",
        "vite.config.js",
        "tsconfig*.json",
        "eslint.config.js",
        ".stylelintrc.json",
        ".prettierrc",
        ".prettierignore"
    ]
}
