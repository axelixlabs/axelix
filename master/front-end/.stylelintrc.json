{
    "extends": "stylelint-config-standard",
    "plugins": ["@stylistic/stylelint-plugin"],
    "rules": {
        "@stylistic/block-opening-brace-space-before": "always",
        "@stylistic/selector-combinator-space-before": "always",
        "@stylistic/selector-combinator-space-after": "always",
        "@stylistic/declaration-block-trailing-semicolon": "always",
        "selector-class-pattern": [
            "^([A-Z][a-zA-Z0-9]+|ant(-[a-z0-9]+)*|recharts(-[a-z0-9]+)+|tp(-[a-z0-9]+)*)$",
            {
                "message": "Class names must be PascalCase, unless they are AntD, Recharts, or timepicker-ui classes (.ant-..., .recharts-..., .tp-...)"
            }
        ],
        "selector-pseudo-class-no-unknown": [
            true,
            {
                "ignorePseudoClasses": [
                    "global"
                ]
            }
        ],
        "color-no-hex": [
            true,
            {
                "severity": "warning",
                "message": "Use a color variable from the :root block of src/index.css instead of a hex literal"
            }
        ],
        "color-named": [
            "never",
            {
                "severity": "warning",
                "message": "Use a color variable from the :root block of src/index.css instead of a named color"
            }
        ],
        "declaration-property-value-allowed-list": [
            {
                "font-size": ["/^var\\(--axelix-font-size-/", "inherit"],
                "font-weight": ["/^var\\(--axelix-font-weight-/", "inherit", "100 900"]
            },
            {
                "severity": "warning",
                "message": "Use the --axelix-font-size-* / --axelix-font-weight-* variables from src/index.css"
            }
        ]
    },
    "overrides": [
        {
            "files": ["src/index.css"],
            "rules": {
                "color-no-hex": null
            }
        }
    ]
}