OTEL_METRICS:   ENABLED, DISABLED

CONFIG_SOURCE:  SPRING_CLOUD, ENV, SYSTEM_PROPERTIES, PROPERTIES_FILE, YAML_FILE

DB:             SQLite, Postgres, MySQL

# Apps registration methods
AUTO_DISCOVERY: ENABLED, DISABLED
SELF_REGISTER:  ENABLED, DISABLED

# Login options
OIDC_LOGIN:     ENABLED, DISABLED
LOCAL_LOGIN:    ENABLED, DISABLED

MCP_SERVER:     ENABLED, DISABLED
